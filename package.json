{
  "name": "noor-tab",
  "displayName": "NoorTab - Islamic New Tab",
  "version": "1.0.1",
  "description": "Transform every new tab into an Islamic companion - prayer times, Adhan reminders, Qibla compass, Adhkar, Quran bookmarks, and more.",
  "author": "Ratul Hasan <ratulhasan.com>",
  "scripts": {
    "dev": "plasmo dev",
    "package": "plasmo package",
    "build": "PLASMO_PUBLIC_DEV_MODE=false node bin/build-prod.js chrome-mv3",
    "build:firefox": "PLASMO_PUBLIC_DEV_MODE=false node bin/build-prod.js firefox-mv2",
    "build:brave": "PLASMO_PUBLIC_DEV_MODE=false node bin/build-prod.js brave-mv3",
    "build:safari": "PLASMO_PUBLIC_DEV_MODE=false node bin/build-prod.js safari-mv3",
    "build:edge": "PLASMO_PUBLIC_DEV_MODE=false node bin/build-prod.js edge-mv3",
    "build:all": "node bin/cleanAll.js && npm run build && npm run build:firefox && npm run build:brave && npm run build:safari && npm run build:edge",
    "zip": "node bin/build-zip.js",
    "package:source": "node bin/package-source.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "vitest run --coverage && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/amiri": "^5.2.8",
    "@plasmohq/messaging": "^0.7.2",
    "@plasmohq/storage": "^1.15.0",
    "adhan": "^4.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.16.0",
    "nanoid": "^5.1.11",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "3.4.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/file-saver": "^2.0.7",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "archiver": "^8.0.0",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "alarms",
      "storage",
      "tabs",
      "activeTab",
      "scripting"
    ],
    "host_permissions": [
      "https://*/*"
    ]
  }
}
